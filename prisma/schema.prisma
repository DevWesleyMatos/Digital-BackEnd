generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  @@map("categories")
  
}
model status {
  id      Int     @id @default(autoincrement())
  name    String
}

model mark {
  id          Int     @id @default(autoincrement())
  name        String
  image_url   String

  @@map("marks")
}
model offers {
	id        Int     @id @default(autoincrement())
	name      String
	value     Decimal
}

