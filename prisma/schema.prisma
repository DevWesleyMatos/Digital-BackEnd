generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model category {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)

  @@map("category")
  
}
model status {
  id      Int     @id @default(autoincrement())
  name    String
}

model mark {
  id          Int     @id @default(autoincrement())
  name        String
  image_url   String
  


  @@map("marks")
}


